# Copy to .env. Compose reads it for host ports; the API and Prisma CLI read it when run on the host.

# Player-facing name of the game. Leave empty to use the default from packages/shared (brand.ts).
CLOSEUP_DISPLAY_NAME=

# Host ports. Change any that is already taken on your machine.
WEB_PORT=3000
API_PORT=3001
POSTGRES_PORT=5432
REDIS_PORT=6379

# Used only when running the API, the tests or the Prisma CLI on the host (not inside Compose,
# which wires its own service URLs). Keep the ports in sync with the ones above.
DATABASE_URL=postgresql://closeup:closeup@localhost:5432/closeup
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:3000

# Set to 1 to also run the tests that need the Compose Postgres and Redis.
CLOSEUP_TEST_INFRA=
TEST_DATABASE_URL=postgresql://closeup:closeup@localhost:5432/closeup
TEST_REDIS_URL=redis://localhost:6379

# Back-office. There is no default admin: create yours once the stack is up with
#   docker compose exec -e ADMIN_EMAIL=you@example.org -e ADMIN_PASSWORD='a long passphrase' api pnpm --filter @closeup/api admin:create
# Optional: the same credentials here let `pnpm smoke` check the back-office too.
SMOKE_ADMIN_EMAIL=
SMOKE_ADMIN_PASSWORD=

# Accounts: the "forgot my password" e-mail. Leave SMTP_URL empty in development: the API log
# then prints the e-mail, link included. In production an empty SMTP_URL means no e-mail at all.
# SMTP_URL=smtp://user:password@mail.example.org:587
SMTP_URL=
MAIL_FROM=closeup <no-reply@localhost>
