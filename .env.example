# Copy to .env. Compose reads it for host ports; the API and Prisma CLI read it when run on the host.

# Player-facing name of the game. Leave empty to use the default from packages/shared (brand.ts).
CLOSEUP_DISPLAY_NAME=

# Host ports. Change any that is already taken on your machine.
WEB_PORT=3000
API_PORT=3001
POSTGRES_PORT=5432
REDIS_PORT=6379

# Used only when running the API, the tests or the Prisma CLI on the host (not inside Compose,
# which wires its own service URLs). Keep the ports in sync with the ones above.
DATABASE_URL=postgresql://closeup:closeup@localhost:5432/closeup
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:3000

# Set to 1 to also run the tests that need the Compose Postgres and Redis.
CLOSEUP_TEST_INFRA=
TEST_DATABASE_URL=postgresql://closeup:closeup@localhost:5432/closeup
TEST_REDIS_URL=redis://localhost:6379
