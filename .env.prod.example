# Production settings. Copy to `.env` on the server and fill in every line.
# Generate the two secrets with: openssl rand -base64 32

# The domain that points at this machine (an A record, and AAAA if you have IPv6).
CLOSEUP_DOMAIN=closeup.example.org
# Let's Encrypt writes to this address if a certificate is about to expire.
CLOSEUP_ACME_EMAIL=you@example.org

POSTGRES_PASSWORD=
# Key of the encrypted media URLs. Changing it invalidates every URL in flight, nothing else.
MEDIA_SECRET=

# Password-reset and e-mail-verification messages. Empty: nothing is sent (see docs/deploy.md).
SMTP_URL=
MAIL_FROM=closeup <no-reply@closeup.example.org>

# Optional: the player-facing name of the game.
# CLOSEUP_DISPLAY_NAME=Closeup
