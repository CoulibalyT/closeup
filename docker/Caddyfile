# One origin for everything: the static game and the API. Cookies are first-party, no CORS.
# `CLOSEUP_DOMAIN` decides the site address; with `localhost` Caddy makes its own certificate,
# with a real domain it gets one from Let's Encrypt on first start.

{
	email {$CLOSEUP_ACME_EMAIL:admin@localhost}
	# Keep websockets alive across a config reload: a running party must not be cut in half.
	servers {
		protocols h1 h2
	}
}

# Registrars hand out a `www` record with the domain, and a cookie set on one host is not sent
# to the other: the game lives at the bare domain, and www only points at it.
www.{$CLOSEUP_DOMAIN:localhost} {
	redir https://{$CLOSEUP_DOMAIN:localhost}{uri} permanent
}

{$CLOSEUP_DOMAIN:localhost} {
	encode zstd gzip

	# Realtime and REST. The API sets its own cache headers; media URLs expire by themselves.
	handle /api/* {
		reverse_proxy api:3001 {
			# Without this the per-IP rate limits would all count the same address: Caddy's.
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}
			# A round lasts 30 s and a socket stays open: no idle timeout below that.
			transport http {
				read_timeout 10m
				write_timeout 10m
			}
		}
	}

	# The built app. Hashed assets are immutable; the shell and the service worker never are.
	handle {
		root * /srv
		@immutable path /_nuxt/* /icon-*.png /apple-touch-icon.png
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@shell path / /index.html /sw.js /manifest.webmanifest
		header @shell Cache-Control "no-cache"
		header {
			X-Content-Type-Options nosniff
			Referrer-Policy strict-origin-when-cross-origin
			# The game is not meant to be framed by anybody.
			X-Frame-Options DENY
		}
		try_files {path} /index.html
		file_server
	}
}
